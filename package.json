{
  "name": "edo-youths-scotland-cic-agency",
  "version": "1.0.0",
  "private": true,
  "description": "A repurposed website concept for Edo Youths Scotland CIC Agency.",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "serve": "python3 -m http.server 4173",
    "check": "tsc --noEmit",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:deploy:self-hosted": "convex deploy --cmd \"echo Skipping build\" --typecheck try",
    "admin:bootstrap": "convex run admin:bootstrap"
  },
  "dependencies": {
    "convex": "^1.39.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
